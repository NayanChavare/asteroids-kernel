static inline void
list_initialize (struct list_node *list)
{
  list->prev = list->next = list;
}

static inline void
list_clear_node (struct list_node *item)
{
  item->prev = item->next = 0;
}

static inline BOOLEAN
list_in_list (struct list_node *item)
{
  if (item->prev == 0 && item->next == 0)
    return ((BOOLEAN)(0==1));
  else
    return ((BOOLEAN)(1==1));
}

static inline void
list_add_head (struct list_node *list, struct list_node *item)
{
  item->next = list->next;
  item->prev = list;
  list->next->prev = item;
  list->next = item;
}



static inline void
